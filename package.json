{
  "name": "circuitlab-3d",
  "private": true,
  "version": "0.3.0",
  "description": "CircuitLab-3D — 面向大学电路教学的交互式三维虚拟实验室",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "test:e2e": "node scripts/browser-check.mjs",
    "test:e2e:advanced": "node scripts/course-check.mjs",
    "test:e2e:wires": "node scripts/wire-check.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
